# ============================================================
# 本地环境变量模板：复制为 .env 后填写（.env 已被 .gitignore 忽略，不要提交）
#   .env 供 docker-compose.local.yml 使用；
#   同名变量也用于启动后端（启动本地环境.bat / PowerShell 会读取）。
# ============================================================

# ---- 数据库（本机 MySQL 8，账号 root）----
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/lanlink_shopping?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=<你的 MySQL root 密码>

# ---- 客服学习沙盒（docker-compose.local.yml）----
# 必须至少 40 字符，例如：powershell -c "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"
SUPPORT_SANDBOX_TOKEN=<40字符以上的随机令牌>
SUPPORT_SANDBOX_URL=http://127.0.0.1:18080
SUPPORT_SANDBOX_MODE=container

# ---- 本地邮件（Mailpit，一般无需修改）----
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=lanlink@local.dev
MAIL_PASSWORD=lanlink-local
MAIL_SMTP_SSL=false

# ---- 客服可信代理密钥（SupportRequestGuard 校验）----
# 必须提供，禁止使用固定默认值（仓库不携带任何密钥）。
# 生成示例：powershell -c "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"
# 前端 Vite 代理与后端 application-dev.yml 读取同名变量，两端必须一致。
SUPPORT_PROXY_SECRET=<40字符以上的随机密钥>

# ---- AI 工具内部通道：读写分离 ----
#
# 为什么需要：内部 secret 通道原先是「一把密钥 = 全部工具」，
# 实测可建采购草稿 / 财务过审 / 签发审批，而网关的写请求正是用这把 secret 调后端的，
# 所以网关侧的角色校验对这条路径完全不生效。
# 更糟的是它此前回退到 SUPPORT_PROXY_SECRET——客服代理密钥顺带握有 AI 写权限。
#
# 配置后：
#   AI_INTERNAL_SECRET       → 只能调只读工具（客服/巡检代理用它）
#   AI_INTERNAL_WRITE_SECRET → 只读 + 写工具（仅授给真正需要写能力的服务）
#
# 留空 `AI_INTERNAL_SECRET` = 内部通道关闭，只走 API Key 通道（fail-closed）。
# 生产必须两个都配，且**必须不同值**。
AI_INTERNAL_SECRET=
AI_INTERNAL_WRITE_SECRET=
# 内部 AI 工具通道来源白名单（逗号分隔 CIDR/单 IP）。默认只接受 compose 网段，
# 并单独排除宿主机 bridge 172.19.0.1——从 127.0.0.1:8080 访问时 remoteAddr 就是它。
# 若不排除，本机任意进程拿到 secret 仍可调写工具。
AI_INTERNAL_ALLOWED_CIDRS=172.19.0.0/16
AI_INTERNAL_DENIED_CIDRS=172.19.0.1/32
# 智能客服思考模式（网关内部推理，最终回答不显示思考过程/知识库来源；false 可关闭）
SUPPORT_AI_THINKING=true

# ---- Redis 缓存（docker-compose 的 redis 服务与后端共用此密码）----
# 必须提供，禁止使用固定默认值（仓库不携带任何密钥）。
# 生成示例：powershell -c "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"
# 容器内后端用 REDIS_HOST=redis 走服务网络；本机直连时改为 127.0.0.1。
REDIS_PASSWORD=<40字符以上的随机密码>
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================
# ---- AI 专用环境变量组（外部大模型 API Key，仅 AI 调用使用）----
# 说明：后端出站模型渠道（客服润色/意图理解/价格智能分析等）按渠道读取：
#   MIMO  渠道  → AI_OUTBOUND_MIMO_API_KEY / AI_MIMO_BASE_URL
#   QWEN  渠道  → AI_QWEN_API_KEY / AI_QWEN_BASE_URL（兼容 DASHSCOPE_API_KEY 旧名）
#   DEEPSEEK 渠道 → AI_DEEPSEEK_API_KEY / AI_DEEPSEEK_BASE_URL
# 留空 = 该渠道禁用（后端自动回退规则引擎）。Key 只走环境变量/管理后台配置，
# 不要写进代码或提交到仓库。
# 密钥面拆分（B3）：出站文本渠道（本组）与 ai-gateway 感知通道（AI_MIMO_*、AI_ASR_*）
# 完全独立——配置感知 key 不会激活后端出站渠道，配置出站 key 也不会启用感知云通道。
# ============================================================
AI_OUTBOUND_MIMO_API_KEY=
AI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
AI_QWEN_API_KEY=
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ---- 本地向量知识库（AI KB）：Ollama 嵌入 + qwen2.5 RAG 问答 ----
# Ollama 地址（后端容器内经 host.docker.internal 访问宿主机 11434）
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
# 嵌入模型：推荐 bge-m3（多语言，1024 维，中文语义区分度好；需先 `docker exec lanlink-ollama ollama pull bge-m3`）
# 轻量可回落 nomic-embed-text（768 维，英文强、中文弱，配合 hybrid 词面重排仍可用）
# 切换模型后需清空 Redis 向量库（aikb:*）并重启后端，让 bootstrap 用新维度重建索引。
AI_EMBED_MODEL=bge-m3
# bge-m3=1024；nomic-embed-text=768。部署切换模型时同步修改，避免降级哈希向量误建新索引。
AI_EMBED_DIM=1024
# 商品知识 outbox worker（发布/审核/编辑后可靠重建向量；关闭后仍保留事件与夜间快照）
AI_KB_OUTBOX_ENABLED=true
AI_KB_OUTBOX_POLL_MS=15000
AI_KB_OUTBOX_BATCH_SIZE=5
AI_KB_OUTBOX_LEASE_MINUTES=20
# AI 网关密钥：必须由你生成并轮换，禁止沿用仓库默认值。
AI_GATEWAY_API_KEY=replace-with-a-long-random-secret

# ---- 外部集成方（Dify / Coze / GPTs / 自研 Agent）的 API Key → 业务角色绑定 ----
#
# 为什么需要：网关的角色若由客户端用 `X-Agent-Role` 自报，任何人拿到 key 都能
# 自称 `buyer` 调写工具（实测同一把 key：support→403、buyer→放行）。
# 绑定后角色由**服务端**决定，客户端改头无效（会记一条 mismatch 警告便于审计）。
#
# 格式：逗号分隔的 `key:role`；role 取值见 ai-gateway/app/tools.py 的 ROLE_TOOL_MAP
#   buyer       商品搜索、报价计算、建采购草稿、知识检索
#   finance     采购单审核、审批签发
#   fulfillment 物流追踪、SLA 监控
#   support     只读：商品/报价/知识/物流（无任何写操作）
#   service     平台内部服务账号：只读 + web_search/fetch_page（无写工具）
#
# `service` 是给**后端自己**的 AI 调用（客服 MCP 编排、知识库
# `chatViaGatewayTools`、媒体感知等）用的。开 `GATEWAY_STRICT_ROLE=1` 前
# 必须把 `AI_GATEWAY_API_KEY` 绑到 `service`，否则后端内部链路会退化成
# 空角色、只剩只读清单里的工具子集（客服仍可用，但会丢 web_search 等能力）。
#
# 示例（每行一把 key，不要真的用下面的占位值）：
#   GATEWAY_KEY_ROLES=sk-dify-buyer-xxxx:buyer,sk-coze-finance-yyyy:finance
#
# 留空 = 所有 key 只读 fail-closed（现有单 key 部署行为不变）。
GATEWAY_KEY_ROLES=
# 可选：网关密钥环（逗号分隔），用于平滑轮换/多集成方。未设置时网关只接受
# AI_GATEWAY_API_KEY。新发独立 key（如 SQLBot 只读 key）时把值加在这里，
# 同时必须在 GATEWAY_KEY_ROLES 绑定角色，否则它只能拿只读默认权限。
GATEWAY_API_KEYS=
#
# 需要「一个 key 多角色」的调试/内部场景时，把 key 列进来显式放开自报：
#   GATEWAY_SELF_ASSERT_KEYS=sk-internal-dev-zzzz
# 生产环境应保持为空——放开即等于允许该 key 冒充任意角色。
GATEWAY_SELF_ASSERT_KEYS=
#
# 严格角色模式：未绑定的 key 不采纳**任何**客户端自报角色
# （X-Agent-Role 头 / ?role= 查询参数 / JSON-RPC params.role），
# 只能拿到只读工具。
#
# 本仓库已切到 1。切之前需要满足两件事，否则会打挂现有链路：
#   1) `AI_GATEWAY_API_KEY` 绑到 `service`（后端内部调用用它）；
#   2) 每个需要写能力的集成方各配一把绑定 key（buyer/finance/fulfillment）。
# 只想兼容旧部署时设 0，但那样「拿到 key 就能自报 buyer」的越权面仍在。
GATEWAY_STRICT_ROLE=1
# 设置后 /kb/reload 还需携带 X-Admin-Key；未设置时保持仅网关 API Key。
GATEWAY_ADMIN_KEY=
#
# 严格模式下的角色 key（多 Agent 验证/压测脚本按角色取用）：
#   GATEWAY_BUYER_KEY / GATEWAY_SUPPORT_KEY /
#   GATEWAY_FINANCE_KEY / GATEWAY_FULFILLMENT_KEY
# 未配置时脚本回落到 AI_GATEWAY_API_KEY，此时写工具会 403（预期行为）。
GATEWAY_BUYER_KEY=
GATEWAY_SUPPORT_KEY=
GATEWAY_FINANCE_KEY=
GATEWAY_FULFILLMENT_KEY=
GATEWAY_RATE_LIMIT_PER_MIN=120
GATEWAY_RATE_LIMIT_BURST=30
# 仅压测/基准环境可设为 1，允许 X-Bypass-Rate-Limit 头豁免限流；生产必须为 0。
GATEWAY_ALLOW_BYPASS_HEADER=0
# 可选：/metrics 独立令牌；设置后 Prometheus 需携带 Authorization: Bearer 或 X-Metrics-Token。
# 占位说明：真实值只写根 .env（勿提交），并同步写入 monitoring/prometheus/metrics_token
# （已 gitignore；由根 docker-compose.yml 只读挂载为 Prometheus credentials_file）。
GATEWAY_METRICS_TOKEN=
# AI 工具内部服务密钥（后端与 ai-gateway 必须同值；多值用逗号分隔以支持轮换）
INTERNAL_GATEWAY_SECRET=replace-with-another-long-random-secret
# 出站大模型域名白名单；自定义服务商需显式追加主机名
AI_OUTBOUND_ALLOWED_HOSTS=api.deepseek.com,dashscope.aliyuncs.com,dashscope-intl.aliyuncs.com,api.xiaomimimo.com,open.bigmodel.cn,api.openai.com,api.moonshot.cn,api.siliconflow.cn,localhost,127.0.0.1,host.docker.internal,lanlink-ai-gateway,ai-gateway,ollama,llama-cpp
# 本地 RAG 生成模型（Ollama 兜底；llama.cpp router 未就绪时使用，如 qwen2.5:0.5b）
AI_LOCAL_CHAT_MODEL=qwen2.5:7b
# 长上下文/兜底文本模型（Ollama，默认轻量 0.5b；本地 7B 由 llama.cpp router 提供）
AI_TEXT_MODEL=qwen2.5:0.5b
# ---- 本地双模型（llama.cpp router 模式，Docker 托管，推荐）----
# 一台 8GB 显存只能同时装一个 7B：router 模式在 qwen2.5-7b(文本) / qwen2.5-vl(视觉) 间按需切换。
# 启动：docker compose -f docker-compose.yml up -d（含 llama-model-init + llama-cpp，模型首次自动导入卷）
# 宿主机源目录（首次导入 Docker 命名卷 llama-models）：按实际 GGUF 路径修改
LLAMA_MODELS_DIR=D:/Docker/toolbox/llama.cpp/models
# 后端外部渠道默认文本模型（客服/价格分析走 7B）；视觉显式走 VL
AI_GATEWAY_MODEL=qwen2.5-7b
AI_GATEWAY_VL_MODEL=qwen2.5-vl
AI_GATEWAY_TEXT_MODEL=qwen2.5-7b
# 容器内 DNS（llama.cpp 服务在根 compose 的 llama-cpp 服务）
AI_MODEL_ROUTER_URL=http://llama-cpp:8123/v1
# 后端访问 ai-gateway 的 OpenAI 兼容基址（容器内服务名 / 宿主机 host.docker.internal 二选一）
AI_GATEWAY_BASE_URL=http://lanlink-ai-gateway:8090/v1
# ---- 向量知识库 MCP 读取通道（契约见 ai-gateway/MCP_KB_SPEC.md）----
# /mcp 挂在网关根路径，不带 /v1，不能复用 AI_GATEWAY_BASE_URL。
# 智能客服接地优先走这里读 aikb-idx；关闭或网关不可达时自动回退 Java 直连检索。
AI_KB_MCP_ENABLED=true
AI_GATEWAY_MCP_URL=http://lanlink-ai-gateway:8090/mcp
# ---- 外部嵌入 / 聊天通道（暂停本地模型时改用；留空即沿用本地链路）----
# provider: ollama|openai（openai 需同时填 BASE_URL/API_KEY/MODEL，任一为空则不生效）
AI_EMBED_PROVIDER=ollama
AI_EMBED_BASE_URL=
AI_EMBED_API_KEY=
AI_CHAT_PROVIDER=local
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
# 切换嵌入模型（本地换维度或改外部 provider）后必须重灌向量库：
# POST /admin/kb/ingest?source=all，否则新旧向量同维度混存会污染检索。
# 文本模型 KV 上限（num_ctx，越大长文本能力越强、显存/内存占用越高）
AI_TEXT_NUM_CTX=12288
# 文本模型闲置驻留时长（Ollama 兜底模型到期自动卸载）
AI_TEXT_KEEP_ALIVE=5m
# 长上下文阈值（字符，仅保留配置兼容；auto 已默认文本模型）
AI_LONG_CONTEXT_CHARS=1200
# ---- 外部资讯自动抓取（RSS -> t_market_news -> Redis 向量库，每 2 小时）----
AI_EXTERNAL_ENABLED=true
AI_EXTERNAL_FEEDS=https://www.ithome.com/rss/,https://www.36kr.com/feed,https://rss.huxiu.com/,https://feeds.a.dj.com/rss/RSSMarketsMain.xml
AI_EXTERNAL_LIMIT=30
# 摘要缺失时用本地 7B 生成中文摘要（最多 2 条/轮，失败忽略）
AI_EXTERNAL_LLM_SUMMARY=true
# 业务相关性过滤：娱乐/消费电子/会员促销/生活方式类资讯不入库（B2B 每日资讯质量）
AI_EXTERNAL_RELEVANCE_FILTER=true
# ---- 意图理解增强（关键词规则 -> 向量 KNN -> 本地 7B 分类，逐级回退）----
AI_INTENT_LLM_ENABLED=true
AI_INTENT_VECTOR_MIN_SCORE=0.55
# ---- AI 商品标题润色配额（out/ai-polish-design.md §3.4，独立键 ai-polish，与价格分析 PRICE_AI_HOURLY_QUOTA 互不挤占）----
# 商户级 10 次/小时/商户（公平闸，防单商户耗尽全局额度）；全局 backstop 60 次/小时（防多商户合计打爆计费渠道）
# 两层均 <=0 时各自关闭
AI_POLISH_USER_HOURLY_QUOTA=10
AI_POLISH_HOURLY_QUOTA=60
# 出站模型配置加密密钥（管理后台 AI 与密钥配置的落库加密，必须提供）
AI_OUTBOUND_KEY_SECRET=<40字符以上的随机密钥>

# ============================================================
# ---- ai-gateway 感知通道（ASR 语音转写 / 视觉 / TTS，仅 ai-gateway 进程持有）----
# AI_ASR_*：语音转写云通道独立密钥组（不与出站 AI_OUTBOUND_MIMO_API_KEY、视觉 AI_MIMO_API_KEY 耦合）。
# 留空 = 云通道关闭，/v1/asr 静默降级本地 asr-service（faster-whisper CPU），不报错不阻塞。
# AI_ASR_MICROS_PER_SECOND：ASR 单价（微元/秒，用于 t_support_llm_usage 成本计量），未配置记 0。
# ============================================================
AI_ASR_API_KEY=
AI_ASR_BASE_URL=https://api.xiaomimimo.com/v1
AI_ASR_MODEL=mimo-v2.5-asr
AI_ASR_MICROS_PER_SECOND=0

# ============================================================
# ---- P2 图像/文件理解扩容（后端解析链计量与视觉降级链）----
# AI_VISION_LOCAL_ENABLED：本地 qwen2.5-vl 腿开关（/v1/vision）。本机无 GPU——llama.cpp
#   GPU 腿在单卡显存口径不可载，默认 false（严禁引入 GPU 依赖）；仅多 GPU 部署显式开启。
#   视觉降级链实际生效序：MiMo 云视觉(/v1/vision-mimo)→ 本地腿(门控)→ RapidOCR(OCR_SERVICE_URL)。
# AI_VISION_MICROS_PER_CALL：视觉单价（微元/次，t_support_llm_usage capability=VISION），未配置记 0。
# AI_DOC_MICROS_PER_KCHAR：文档解析单价（微元/千字符，capability=DOC），未配置记 0。
# SUPPORT_MEDIA_PDF_SCAN_PAGES：扫描版 PDF 视觉兜底渲染页数，默认 3。
# ============================================================
AI_VISION_LOCAL_ENABLED=false
AI_VISION_MICROS_PER_CALL=0
AI_DOC_MICROS_PER_KCHAR=0
SUPPORT_MEDIA_PDF_SCAN_PAGES=3

# ============================================================
# ---- 字段级加解密体系配置 (RSA-2048 + JWE / Legacy AES-GCM 兜底) ----
# 说明：项目中所有弱 RSA-1024 算法已全面升级为 RSA-2048 标准。
#   - LANLINK_CRYPTO_SECRET: legacy AES-256-GCM 主密钥 (历史密文兼容读出)
#   - LANLINK_CRYPTO_JWE_ENABLED: 是否启用 JWE 标准加密 (默认 true)
#   - LANLINK_CRYPTO_JWE_REQUIRED: 生产环境是否强校验密钥 (默认 false，缺省时降级 legacy)
#   - LANLINK_CRYPTO_MIN_RSA_BITS: 最低 RSA 密钥长度 (绝对安全底线 2048 位，强校验)
#   - LANLINK_CRYPTO_JWE_ACTIVE_KID / PRIVATE_KEY / PUBLIC_KEY: RSA-2048 密钥对
#   (本地启动脚本 start-local-env.ps1 会在留空时自动为会话动态生成 2048 位密钥对)
# ============================================================
LANLINK_CRYPTO_SECRET=
LANLINK_CRYPTO_JWE_ENABLED=true
LANLINK_CRYPTO_JWE_REQUIRED=false
LANLINK_CRYPTO_MIN_RSA_BITS=2048
LANLINK_CRYPTO_JWE_ACTIVE_KID=
LANLINK_CRYPTO_JWE_ACTIVE_PRIVATE_KEY=
LANLINK_CRYPTO_JWE_ACTIVE_PUBLIC_KEY=

# ============================================================
# ---- 共享环境变量组（高频复用，多处引用同一份值）----
# 前后端/多容器共用：改一处全端生效，避免散落同名变量不同值。
# ============================================================
# 应用对外域名/地址（前端跳转、回调、邮件链接等引用）
APP_PUBLIC_URL=http://localhost:5173
# 后端 API 基址（前端构建注入 VITE_API_BASE_URL，默认 /api 走同源代理）
VITE_API_BASE_URL=/api
# ---- 高德地图开放平台商业图源配置（可选；后端侧变量，仅后端持有，不进前端构建产物） ----
# 申请地址：https://console.amap.com/（创建 Web 端 JS API Key）
# docker-compose 注入 backend 容器；登录用户经 GET /api/logistics/map-config 拉取，留空时前端回退内置高精中国地理矢量底图
AMAP_KEY=your_amap_jsapi_key_here
AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here
# 限流与安全通用参数
AUTH_RATE_LIMIT_PER_MIN=20
# 演示数据开关（后端 DataInitializer）
LANLINK_DEMO_DATA_ENABLED=true
# 时区（调度任务/日期聚合统一时区，价格监控每日基准等依赖）
APP_TIMEZONE=Asia/Shanghai

# ============================================================
# ---- 对象存储与消息队列（out/storage-mq-plan.md A1/A2/B1/B4，docker-compose 的 minio/rabbitmq 服务）----
# 说明：库内一律存 object key（如 products/1001.webp），出站拼公开绝对 URL；
#       docker compose up 前必须填写 MINIO_*/RABBITMQ_*/LANLINK_S3_*（compose 用 :? 强制校验）。
#       LANLINK_S3_ACCESS_KEY/SECRET_KEY 是专用最小权限应用账号（固定名 lanlink-app，
#       minio-init 首次 up 时幂等创建：products/* 只 Get/Put、support-media/support/* 读写删、
#       products/attachments/* 才允许 Delete），必须与
#       MINIO_ROOT_* 不同值——root 凭据只留在 MINIO_ROOT_*，绝不注入后端
#       （LANLINK_S3_* 为空时后端启动即 fail-fast，无 minioadmin 兜底）。
# ============================================================
# MinIO root 凭据（仅 minio / minio-init 两个容器使用；建桶/策略/运维走 mc 时用）
# 生成示例：powershell -c "[guid]::NewGuid().ToString('N')"
MINIO_ROOT_USER=<本地 MinIO root 用户名>
MINIO_ROOT_PASSWORD=<本地 MinIO root 密码>
# 后端专用 S3 账号（账号名即访问键）：密码须 32+ 位随机串且与 MINIO_ROOT_PASSWORD 不同值
LANLINK_S3_ACCESS_KEY=lanlink-app
LANLINK_S3_SECRET_KEY=<32位以上随机串，与 MINIO_ROOT_PASSWORD 不同值>
# 可选：按用途拆分的最小权限账号（留空则不创建；后端当前仍用上面的单账号）
# 设了 *_ACCESS_KEY 时 minio-init 会建用户并绑定对应策略：
#   lanlink-products-rw-policy → products/* 读写 + products/attachments/* 删
#   lanlink-support-rw-policy  → support-media/support/* 读写删
LANLINK_S3_PRODUCTS_ACCESS_KEY=
LANLINK_S3_PRODUCTS_SECRET_KEY=
LANLINK_S3_SUPPORT_ACCESS_KEY=
LANLINK_S3_SUPPORT_SECRET_KEY=
# RabbitMQ 凭据（AMQP 127.0.0.1:5672 / 管理 UI 127.0.0.1:15672，均仅绑回环）
# 注意：节点挂持久化卷后 RABBITMQ_DEFAULT_USER/PASS 仅首启生效；改密码须先
# rabbitmqctl change_password 再同步改这里（流程见 docker-compose.yml rabbitmq 段注释）
RABBITMQ_USER=<本地 RabbitMQ 用户名>
RABBITMQ_PASSWORD=<本地 RabbitMQ 密码>
# 三节点共享 Erlang cookie：三节点必须同值，生产使用长随机串，不要提交明文
RABBITMQ_ERLANG_COOKIE=<长随机 cookie>
# 对象存储全链路开关：false = 上传回退本地盘、出站 URL 原样输出（一键回退现状）
LANLINK_STORAGE_ENABLED=true
# S3 端点（本机/裸跑后端用 localhost:9000；compose 内后端容器由 compose 固定注入 http://minio:9000）
LANLINK_S3_ENDPOINT=http://localhost:9000
LANLINK_S3_REGION=us-east-1
LANLINK_S3_BUCKET=products
# MinIO 必须 true（path-style）；切腾讯 COS/阿里 OSS 时改 false（仅改 env，代码零改动）
LANLINK_S3_PATH_STYLE=true
# 浏览器侧公开读地址（出站拼 URL 前缀；prod 换实际存储域名/CDN）
LANLINK_S3_PUBLIC_BASE_URL=/products
# 订单支付流消费通道开关：mq=走 RabbitMQ（默认），event=回退 Spring 事件通道（与 MQ 互斥防双计）
LANLINK_MQ_ORDER_FLOW=mq
# 系统通知消费通道开关：mq=RabbitMQ + Outbox 重投（默认），event=回退提交后直发监听器（与 MQ 互斥，防双发）
LANLINK_MQ_NOTIFY_FLOW=mq

# ============================================================
# ---- Stripe 跨境国际支付与多渠道收银配置 ----
# 映射位置：backend/src/main/resources/application-payment.yml:45-49（optional 本地文件，已被 .gitignore 忽略；
#           新克隆/CI 构建缺失该文件时以下键不会绑定，Stripe 渠道 configured()=false → 选 Stripe 支付报"未配置"）。
#           三键的 Spring 名为 lanlink.payment.stripe.secret-key / publishable-key / webhook-secret。
# ============================================================
# 后端私钥：API 扣款与 PaymentIntent 创建密钥 (sk_test_... 或 sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# 后端 Webhook 验签密钥 (whsec_...)，从 Stripe 开发者仪表板 Webhook 端点获取
# 留空/填错：/api/payment/notify/stripe 验签失败 → 订单停在未支付但渠道已扣款（需按资金异常 SOP 对账）
STRIPE_WEBHOOK_SECRET=
# 默认结算货币代码 (三位 ISO 小写代码，默认 cny，可选 usd, eur, hkd)
STRIPE_CURRENCY=cny
# 前端公钥：用于挂载 Stripe Elements 与 Apple Pay / Google Pay 快捷支付 (pk_test_... 或 pk_live_...)
# 注意：该 VITE_ 变量同时被后端运行时读取（application-payment.yml 的 publishable-key 回退键为 STRIPE_PUBLISHABLE_KEY）
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ============================================================
# ---- 关单 / 支付入口门禁 / P0-B 收款冲突自动补偿 ----
# 说明：以下键里 app.order.* 已桥接为 LANLINK_* 并写在 application.yml:198-202；
#       APP_PAYMENT_* 仅由代码 @Value 默认值兜底（application.yml 未声明），裸跑时可用环境变量覆盖。
# ⚠️ docker compose 的 backend environment 是显式白名单（docker-compose.yml:373 起），
#    未透传 LANLINK_ORDER_AUTOCLOSE_* / APP_PAYMENT_* / STRIPE_*，因此改本文件对容器内后端无效；
#    且 compose 把 LANLINK_PAYMENT_MOCK 硬编码为 "true"（docker-compose.yml:398），.env 写 false 也不生效。
#    裸跑（start-local-env.ps1 加载 .env）时以下变量才全部生效。
# 详细含义/改错后果见 docs/资金支付配置速查-v1.0.md
# ============================================================
# 模拟支付总开关：dev 默认 true；生产必须 false（true=可无真实付款下单，属 P0 资金事故）
LANLINK_PAYMENT_MOCK=true
# 超时未支付订单自动关闭：开关 / 阈值分钟（同时决定渠道单过期时间）/ 轮询间隔 / 首轮延迟
LANLINK_ORDER_AUTOCLOSE_ENABLED=true
LANLINK_ORDER_AUTOCLOSE_MINUTES=30
LANLINK_ORDER_AUTOCLOSE_INTERVAL_MS=60000
LANLINK_ORDER_AUTOCLOSE_INITIAL_MS=30000
# ---- P1-5 运费报价总开关（backend FreightQuoteService，application.yml 的 app.freight.*）----
# enabled 默认 false：全站运费恒 0，不查模板/不打包邮/不加价，与运费未接入前行为一致；
# 用于防止“默认模板 id=1 命中历史模板”给全站每单凭空加运费（上线即资损/客诉）。
# 启用顺序：先在 t_logistics_template 配好可用默认模板（status=1）→ 验证 quote 金额 →
# 再置 APP_FREIGHT_ENABLED=true（或直接改 application.yml 默认值）→ 小流量灰度观察资损/客诉。
# ⚠️ docker compose 的 backend environment 是显式白名单，当前未透传 APP_FREIGHT_*；
#    容器内启用需改 application.yml 默认值重建镜像，或把变量加入 compose（本次未改 compose）。
APP_FREIGHT_ENABLED=false
# 平台默认运费模板 id（t_logistics_template.id），仅 enabled=true 时生效；缺失/停用会 fail-open=0+WARN
APP_FREIGHT_DEFAULT_TEMPLATE_ID=1
# 建单时至少保留的支付窗口（分钟）：渠道单过期=创建时间+关单阈值，本值兜底避免窗口过短
APP_PAYMENT_CHANNEL_EXPIRE_SAFETY_MARGIN_MINUTES=5
# P0-B 收款冲突自动补偿（t_payment_conflict）：总开关 / 每轮批量 / 只扫最近N分钟 / 僵死抢单回收分钟 / 轮询与首轮延迟 / 最大重试次数
APP_PAYMENT_CONFLICT_AUTO_REFUND_ENABLED=true
APP_PAYMENT_CONFLICT_BATCH=50
APP_PAYMENT_CONFLICT_SCAN_WINDOW_MINUTES=1440
APP_PAYMENT_CONFLICT_STALE_CLAIM_MINUTES=10
APP_PAYMENT_CONFLICT_COMPENSATE_INTERVAL_MS=60000
APP_PAYMENT_CONFLICT_COMPENSATE_INITIAL_DELAY_MS=30000
APP_PAYMENT_CONFLICT_MAX_RETRY=8

# ============================================================
# ---- 自建物流跟踪（out/logistics-tracking-plan.md P1，backend module/tracking）----
# 说明：真实渠道密钥仅由后端经环境变量持有，不入库不入仓（t_logistics_provider.api_key 不存真值）。
#       留空=对应通道 configured()=false，自动退化为定时补拉兜底路径，回调链路仍可验签演示。
# ============================================================
# 快递100 企业版授权（订阅推送需企业版；申请地址 https://api.kuaidi100.com，后端侧变量不进前端）
TRACKING_KUAIDI100_KEY=your_kuaidi100_key_here
TRACKING_KUAIDI100_CUSTOMER=your_kuaidi100_customer_here
# 推送方向验签盐：sign=MD5(param+salt) 32 位大写；泄露=任何人可伪造推送，务必长随机串
TRACKING_KUAIDI100_SALT=your_kuaidi100_salt_here
# 请求端签名算法 SHA256/MD5（推送回调方向固定 MD5，不可升级）
TRACKING_KUAIDI100_SIGN_TYPE=SHA256
# 回调 URL 路径段共享 token（Mock 共用）。代码侧已无默认值：留空 = 拒绝全部 URL-token 回调；
# 必须 >= 16 位，建议 32 位随机 hex：
#   powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N').Substring(0,16)"
# 历史值 dev-callback-token 已被识别为弱 token，即使填上也会验签失败（审计 P1-3）。
# 模板占位符（含 your_ / _here / changeme / placeholder）同样判为弱 token——
# 复制模板后必须换成真实随机值，否则回调会被 401 拒绝。
TRACKING_CALLBACK_URL_TOKEN=
# 跟踪链路总开关（false 时 ship 主流程零影响，仅 tracking 侧短路）
TRACKING_ENABLED=true
# 成功回调/成功补拉后顺延 next_poll_time 的间隔 ms（巡检 cron 默认每 10 分钟，见 application.yml）
TRACKING_POLL_INTERVAL_MS=600000

# ============================================================
# ---- 告警送达（钉钉/企微机器人 webhook，monitoring/alertmanager 双通道之一）----
# 说明：填钉钉/企微机器人 webhook，不提交真实值（真实地址只放根 .env，.env 已被 .gitignore 忽略）。
#       钉钉「自定义机器人」地址形如 https://oapi.dingtalk.com/robot/send?access_token=xxxx
#       企业微信群机器人形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
#       留空=占位地址兜底，适配器仍可启动但外发会失败（邮件通道不受影响，仍照常送达）。
#       改完执行 docker compose up -d dingtalk-webhook-adapter 让适配器重建生效。
# ============================================================
DINGTALK_WEBHOOK_URL=

# ============================================================
# ---- 告警送达（飞书自建应用，monitoring/alertmanager 三通道之一）----
# 说明：飞书开放平台「企业自建应用」凭据，不提交真实值（真实值只放根 .env，.env 已被 .gitignore 忽略）。
#       ① 飞书开放平台创建自建应用，拿 App ID（cli_ 开头）与 App Secret，开通 im:message 发消息权限并发布版本；
#       ② 把应用机器人添加进告警群（群设置→群机器人→添加应用机器人）；
#       ③ curl 127.0.0.1:8061/feishu/health 列出机器人所在群的 chat_id，回填 FEISHU_CHAT_ID；
#       FEISHU_CHAT_ID 留空=适配器健康端点可列群，告警外发会跳过并提示（邮件通道不受影响）。
#       改完执行 docker compose up -d feishu-webhook-adapter 让适配器重建生效。
# ============================================================
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# ============================================================
# ---- RAG-Anything 多模态知识检索（rag-service，端口 8093）----
# 说明：本服务是**内部服务**，只给 backend 调用，不对公网暴露（compose 里只绑 127.0.0.1）。
#
# ① RAG_INTERNAL_SECRET 是 backend 与 rag-service 之间的共享密钥，必须两边一致。
#    **不要留空**：rag-service 在密钥为空时会拒绝所有 /ingest 与 /query（fail-closed），
#    这是刻意的——否则忘配密钥就等于内部服务裸奔。
#    生成建议：python -c "import secrets;print(secrets.token_urlsafe(32))"
#
# ② RAG_LLM_API_KEY 必须与 AI_GATEWAY_API_KEY 相同（复用同一把网关密钥）。
#    下面写成变量引用，compose 会展开；单独部署 rag-service 时才需要显式填。
#
# ③ 服务不占 GPU：索引与检索都在 CPU，LLM/VLM/Embedding 全部转发给 ai-gateway
#    （显存由网关的调度器统一管理）。这也是为什么基础镜像用 python:3.14——
#    3.14 会自动跳过 MinerU 的 torch+CUDA 依赖，镜像从 6.3GB 降到 ~640MB。
# ============================================================
RAG_INTERNAL_SECRET=
RAG_SERVICE_BASE_URL=http://lanlink-rag-service:8093
RAG_LLM_API_KEY=${AI_GATEWAY_API_KEY:-}
# 索引存储目录（容器内路径，由 compose 的 rag-storage 卷挂载持久化）
RAG_WORKING_DIR=/data/rag_storage
# 召回数量：与现有 aikb 的 top_k 口径保持一致，便于对比两套检索结果
RAG_TOP_K=20
# 单次 LLM 调用超时（秒）。本地 7B 在 4070 上约 2-15s，索引时的实体抽取更慢，留足余量
RAG_LLM_TIMEOUT=180
#
# ④ 向量存储后端（2026-11 起默认 redis）
#    LightRAG 1.4.16 的 Redis 实现只有 KV 与 DocStatus，**没有 vector**，
#    所以本项目自研了 rag-service/app/redis_vector_store.py（RediSearch HNSW），
#    并注册进 lightrag 的 STORAGES / STORAGE_IMPLEMENTATIONS。
#
#    索引名与 key 前缀完全独立，三套向量索引互不连坐：
#      aikb-idx                        / aikb:vblob:            Java 知识库
#      prod-idx                        / prod:vblob:            Java 商品向量
#      rag-idx:<workspace>:<namespace> / rag:vblob:<ws>:<ns>:   本服务
#    任一处 FT.DROPINDEX 都不会连带删除另外两套数据。
#
#    回滚：把 RAG_VECTOR_BACKEND 改成 nano，索引退回 rag-storage 卷里的 JSON 文件。
RAG_VECTOR_BACKEND=redis
# 复用 shopping-redis-1（Redis Stack，已加载 RediSearch）。密码由
# config.resolved_redis_uri() 做 URL 编码后拼进连接串，无需手写 redis:// URL。
REDIS_HOST=redis
REDIS_PORT=6379
RAG_REDIS_DB=0

# ============================================================
# ---- SQLBot 问数（ai-gateway lanlink_ask_data 工具经 SQLBot MCP 调用）----
# SQLBot MCP 登录凭据（明文比对，无解密层）：真实值只写根 .env，本文件留占位。
# SQLBOT_MCP_URL 是 ai-gateway 容器访问 SQLBot 的地址（shopping_default 网络）。
SQLBOT_MCP_URL=http://sqlbot:8000
SQLBOT_USERNAME=
SQLBOT_PASSWORD=
# 第八节 P1-1：镜像首次启动的默认口令仅用于首次登录，必须立即通过
# `POST /api/v1/login/change-pwd` 换成这里的高强度值；禁止复用镜像默认值。
# SQLBot 调网关用的**独立只读** key：与主 key 分离，角色由 GATEWAY_KEY_ROLES
# 绑定为 support（只读）。SQLBot 管理端可读回 ai_model.api_key，一旦复用主 key，
# 默认密码/低权限账号泄露就会升级成网关写权限。生成后同时写进 GATEWAY_KEY_ROLES。
SQLBOT_GATEWAY_KEY=
# SQLBot 数据源只读账号（MySQL 仅 SELECT lanlink_shopping.*）；密码独立于 root。
SQLBOT_DB_USER=sqlbot_ro
SQLBOT_DB_PASSWORD=

# ============================================================
# ---- MCP fetch/playwright 工具桥（ai-gateway 经内网 MCP server 扩展工具）----
# 两个 MCP server：mcp-fetch（自建 HTTP→stdio 桥，包官方 mcp-server-fetch）与
# mcp-playwright（官方镜像 mcr.microsoft.com/playwright/mcp，streamable HTTP）。
# 均为 shopping_default 内网服务，不映射宿主端口。
#
# 默认关闭：LANLINK_MCP_ENABLED=0 时网关不发起任何连接、不注册任何 mcp_* 工具，
# 既有对话与四件内置工具行为零变化；mcp-fetch/mcp-playwright 两个容器也可以
# `docker compose stop mcp-fetch mcp-playwright` 回收约 1.2g 内存。
#
# 启用步骤（改 .env 后必须重建——env 是容器创建时固化）：
#   1) LANLINK_MCP_ENABLED=1
#   2) LANLINK_MCP_ROLE_TOOLS 按需配映射（默认空=fail-closed，所有角色都调不到）
#   3) docker compose up -d --build mcp-fetch mcp-playwright ai-gateway
#
# 安全边界（如实声明）：
#   - SSRF：URL 参数在网关 handler 入口先过 _ssrf_guard（内网/环回/十进制变体全拦），
#     官方 fetch server(>=2026.6.4) 自身还带私网拒绝与逐跳重定向复检；
#   - 残余风险：MCP server 自身不受网关守卫保护的场景只剩「网关已放行的公网 URL
#     在 server 侧 302 跳内网」——新版 fetch server 逐跳复检已覆盖；playwright 侧
#     用 LANLINK_MCP_BLOCKED_HOSTS 出站黑名单缓解（精确匹配目标 host）；
#   - 角色门禁：LANLINK_MCP_ROLE_TOOLS 无映射条目的角色一律拒绝（含未声明角色）；
#     all/* 沿超管口径放行；写入 support 的条目解析期直接丢弃并告警
#     （客服不开放外部网页）；
#   - 白名单：只暴露 5 个只读工具（mcp_fetch / mcp_browser_navigate /
#     mcp_browser_snapshot / mcp_browser_find / mcp_browser_close），
#     server 升级新增的高危工具（browser_evaluate / browser_run_code_unsafe）
#     不会静默上线；
#   - 验收提示：角色路径建议配 GATEWAY_KEY_ROLES 绑定 key（生产严格模式下
#     X-Agent-Role 自报无效），见上方 GATEWAY_KEY_ROLES 注释。
LANLINK_MCP_ENABLED=0
# mcp-fetch 桥地址（ai-gateway 容器视角，服务名直连；留空=禁用该 server）
LANLINK_MCP_FETCH_URL=http://mcp-fetch:8781/mcp
# mcp-playwright 官方镜像 streamable HTTP 端点；留空=禁用（可单独停 playwright 省内存）
LANLINK_MCP_PLAYWRIGHT_URL=http://mcp-playwright:8782/mcp
# tools/call 超时毫秒：fetch 与镜像内 timeout_ms 默认一致；playwright 浏览器导航更慢
LANLINK_MCP_FETCH_TIMEOUT_MS=30000
LANLINK_MCP_PLAYWRIGHT_TIMEOUT_MS=60000
# 健康重探周期秒：连续 2 次失败静默摘除 mcp_* 工具，恢复后自动重注册
LANLINK_MCP_HEALTH_INTERVAL_SEC=30
# 角色→工具显式映射：格式 `角色:工具1|工具2`，逗号分隔多条目，如
#   buyer:mcp_fetch|mcp_browser_navigate|mcp_browser_snapshot|mcp_browser_find|mcp_browser_close,ops:mcp_fetch
# 默认空 = fail-closed。改后需重建网关。
LANLINK_MCP_ROLE_TOOLS=
# 出站抓取黑名单：逗号分隔主机名（精确匹配目标 URL host），命中的调用入口直接拒绝。
# 缓解（非根除）公网 302→内网；根除需自研守卫等价 fetch server（后续可选项）。
LANLINK_MCP_BLOCKED_HOSTS=
# fetch server 对外 User-Agent（可审计标识，默认 lanlink-ai-gateway 前缀）
LANLINK_MCP_USER_AGENT=lanlink-ai-gateway (+internal bridge)
# 1=忽略 robots.txt（官方 fetch server 默认遵守；内网灰度可按需放开）
LANLINK_MCP_IGNORE_ROBOTS=0

# ============================================================
# ---- 资讯处理管线（ai-gateway /v1/news/extract + Java 编排落库）----
# 网关侧：robots 门禁（protego，24h TTL）+ 逐跳 SSRF 守卫抓取 + trafilatura 降噪
# + 三层判重（Redis newsp:* 命名空间）；网关不连 MySQL，落库放行权在 Java 编排层
# （backend ExternalInfoFetchService 按 flags.stored 决定是否写 t_market_news）。
# 必须同步加进 docker-compose.yml 的 ai-gateway.environment 才会进容器
# （backend 无 env_file，AI_NEWS_PIPELINE_* 由 compose backend.environment 显式注入）。
# 总开关=0 时 /v1/news/extract 返回 404、既有链路零行为变化。
LANLINK_NEWSPIPELINE_ENABLED=0
# 出站 UA（RFC 9309：product token 应为 HTTP UA 子串，robots 匹配与抓取自标识同源）
LANLINK_NEWSPIPELINE_UA=LanlinkNewsPipeline/1.0 (+https://www.lanlink.shopping/contact)
# robots.txt 缓存 TTL 秒（RFC 9309 上限 24h）
LANLINK_NEWSPIPELINE_ROBOTS_TTL_SECONDS=86400
# robots 抓取超时毫秒（传入 _guarded_get 的 timeout 参数，SSRF 守卫链不变）
LANLINK_NEWSPIPELINE_ROBOTS_TIMEOUT_MS=5000
# 单页响应字节上限（对齐 ExternalInfoFetchService 的 2MB；robots 抓取固定 500KiB 上限不随此键）
LANLINK_NEWSPIPELINE_MAX_BYTES=2097152
# 跳数上限（覆盖 _guarded_get 缺省读的 LANLINK_FETCH_MAX_REDIRECTS）
LANLINK_NEWSPIPELINE_MAX_REDIRECTS=5
# L1 指纹键与候选集 TTL（30 天）
LANLINK_NEWSPIPELINE_DEDUP_TTL_SECONDS=2592000
# 同源时间窗（小时）：L3 标题近重/simhash 候选比对窗口；newsp:review 审计 TTL=窗长
LANLINK_NEWSPIPELINE_WINDOW_HOURS=72
# simhash 提示层海明阈值（提示层不硬拒，仅产 needsReview 信号；实测改写对与无关对
# 分布有重叠，20bit 下两群体均部分进入提示——不参与 verdict 判定，噪声可接受）
LANLINK_NEWSPIPELINE_SIMHASH_BITS=20
# 同源标题近重阈值：ratio≥0.9 → near_duplicate；0.75-0.9 灰区 → needs_review（不落库）
LANLINK_NEWSPIPELINE_TITLE_RATIO=0.9
# 单条端到端预算毫秒：超时 ok=false 不阻塞批次
LANLINK_NEWSPIPELINE_TIMEOUT_MS=8000
# ---- Java 编排开关（docker-compose.yml backend.environment 已显式注入 ${...:-默认}，
# backend 无 env_file，仅写 .env 不改 compose 无效）----
AI_NEWS_PIPELINE_ENABLED=false
AI_NEWS_PIPELINE_FALLBACK=true

# ---- workflow 商品导入接口鉴权（审计 P1-4）----
# `POST /api/import` 与 `GET /api/import/{runId}` 必须带 `X-Import-Token`
# （或 `Authorization: Bearer`）。未配置 = 接口返回 503，不提供「无配置即放行」。
# 生成：powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
# 前端本地开发把同一个值写进 frontend/.env.local 的 VITE_WORKFLOW_IMPORT_TOKEN；
# 生产由 nginx 注入请求头，不要把 token 打进前端包。
WORKFLOW_IMPORT_TOKEN=
