# ============================================================
# 本地环境变量模板：复制为 .env 后填写（.env 已被 .gitignore 忽略，不要提交）
#   .env 供 docker-compose.local.yml 使用；
#   同名变量也用于启动后端（启动本地环境.bat / PowerShell 会读取）。
# ============================================================

# ---- 数据库（本机 MySQL 8，账号 root）----
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/lanlink_shopping?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=<你的 MySQL root 密码>

# ---- 客服学习沙盒（docker-compose.local.yml）----
# 必须至少 40 字符，例如：powershell -c "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"
SUPPORT_SANDBOX_TOKEN=<40字符以上的随机令牌>
SUPPORT_SANDBOX_URL=http://127.0.0.1:18080
SUPPORT_SANDBOX_MODE=container

# ---- 本地邮件（Mailpit，一般无需修改）----
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=lanlink@local.dev
MAIL_PASSWORD=lanlink-local
MAIL_SMTP_SSL=false

# ---- 客服可信代理密钥（SupportRequestGuard 校验）----
# 必须提供，禁止使用固定默认值（仓库不携带任何密钥）。
# 生成示例：powershell -c "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"
# 前端 Vite 代理与后端 application-dev.yml 读取同名变量，两端必须一致。
SUPPORT_PROXY_SECRET=<40字符以上的随机密钥>
# 智能客服思考模式（网关内部推理，最终回答不显示思考过程/知识库来源；false 可关闭）
SUPPORT_AI_THINKING=true

# ---- Redis 缓存（docker-compose 的 redis 服务与后端共用此密码）----
# 必须提供，禁止使用固定默认值（仓库不携带任何密钥）。
# 生成示例：powershell -c "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"
# 容器内后端用 REDIS_HOST=redis 走服务网络；本机直连时改为 127.0.0.1。
REDIS_PASSWORD=<40字符以上的随机密码>
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================
# ---- AI 专用环境变量组（外部大模型 API Key，仅 AI 调用使用）----
# 说明：后端出站模型渠道（客服润色/意图理解/价格智能分析等）按渠道读取：
#   MIMO  渠道  → AI_MIMO_API_KEY / AI_MIMO_BASE_URL
#   QWEN  渠道  → AI_QWEN_API_KEY / AI_QWEN_BASE_URL（兼容 DASHSCOPE_API_KEY 旧名）
#   DEEPSEEK 渠道 → AI_DEEPSEEK_API_KEY / AI_DEEPSEEK_BASE_URL
# 留空 = 该渠道禁用（后端自动回退规则引擎）。Key 只走环境变量/管理后台配置，
# 不要写进代码或提交到仓库。
# ============================================================
AI_MIMO_API_KEY=
AI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
AI_QWEN_API_KEY=
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ---- 本地向量知识库（AI KB）：Ollama 嵌入 + qwen2.5 RAG 问答 ----
# Ollama 地址（后端容器内经 host.docker.internal 访问宿主机 11434）
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
# 嵌入模型：推荐 bge-m3（多语言，1024 维，中文语义区分度好；需先 `docker exec lanlink-ollama ollama pull bge-m3`）
# 轻量可回落 nomic-embed-text（768 维，英文强、中文弱，配合 hybrid 词面重排仍可用）
# 切换模型后需清空 Redis 向量库（aikb:*）并重启后端，让 bootstrap 用新维度重建索引。
AI_EMBED_MODEL=bge-m3
# 本地 RAG 生成模型（Ollama 兜底；llama.cpp router 未就绪时使用，如 qwen2.5:0.5b）
AI_LOCAL_CHAT_MODEL=qwen2.5:7b
# 长上下文/兜底文本模型（Ollama，默认轻量 0.5b；本地 7B 由 llama.cpp router 提供）
AI_TEXT_MODEL=qwen2.5:0.5b
# ---- 本地双模型（llama.cpp router 模式，Docker 托管，推荐）----
# 一台 8GB 显存只能同时装一个 7B：router 模式在 qwen2.5-7b(文本) / qwen2.5-vl(视觉) 间按需切换。
# 启动：docker compose -f docker-compose.yml up -d（含 llama-model-init + llama-cpp，模型首次自动导入卷）
# 宿主机源目录（首次导入 Docker 命名卷 llama-models）：按实际 GGUF 路径修改
LLAMA_MODELS_DIR=D:/Docker/toolbox/llama.cpp/models
# 后端外部渠道默认文本模型（客服/价格分析走 7B）；视觉显式走 VL
AI_GATEWAY_MODEL=qwen2.5-7b
AI_GATEWAY_VL_MODEL=qwen2.5-vl
AI_GATEWAY_TEXT_MODEL=qwen2.5-7b
# 容器内 DNS（llama.cpp 服务在根 compose 的 llama-cpp 服务）
AI_MODEL_ROUTER_URL=http://llama-cpp:8123/v1
# 文本模型 KV 上限（num_ctx，越大长文本能力越强、显存/内存占用越高）
AI_TEXT_NUM_CTX=12288
# 文本模型闲置驻留时长（Ollama 兜底模型到期自动卸载）
AI_TEXT_KEEP_ALIVE=5m
# 长上下文阈值（字符，仅保留配置兼容；auto 已默认文本模型）
AI_LONG_CONTEXT_CHARS=1200
# ---- 外部资讯自动抓取（RSS -> t_market_news -> Redis 向量库，每 2 小时）----
AI_EXTERNAL_ENABLED=true
AI_EXTERNAL_FEEDS=https://www.ithome.com/rss/,https://www.36kr.com/feed,https://rss.huxiu.com/,https://feeds.a.dj.com/rss/RSSMarketsMain.xml
AI_EXTERNAL_LIMIT=30
# 摘要缺失时用本地 7B 生成中文摘要（最多 2 条/轮，失败忽略）
AI_EXTERNAL_LLM_SUMMARY=true
# 业务相关性过滤：娱乐/消费电子/会员促销/生活方式类资讯不入库（B2B 每日资讯质量）
AI_EXTERNAL_RELEVANCE_FILTER=true
# ---- 意图理解增强（关键词规则 -> 向量 KNN -> 本地 7B 分类，逐级回退）----
AI_INTENT_LLM_ENABLED=true
AI_INTENT_VECTOR_MIN_SCORE=0.55
# 出站模型配置加密密钥（管理后台 AI 与密钥配置的落库加密，必须提供）
AI_OUTBOUND_KEY_SECRET=<40字符以上的随机密钥>

# ============================================================
# ---- 共享环境变量组（高频复用，多处引用同一份值）----
# 前后端/多容器共用：改一处全端生效，避免散落同名变量不同值。
# ============================================================
# 应用对外域名/地址（前端跳转、回调、邮件链接等引用）
APP_PUBLIC_URL=http://localhost:5173
# 后端 API 基址（前端构建注入 VITE_API_BASE_URL，默认 /api 走同源代理）
VITE_API_BASE_URL=/api
# 限流与安全通用参数
AUTH_RATE_LIMIT_PER_MIN=20
# 演示数据开关（后端 DataInitializer）
LANLINK_DEMO_DATA_ENABLED=true
# 时区（调度任务/日期聚合统一时区，价格监控每日基准等依赖）
APP_TIMEZONE=Asia/Shanghai
