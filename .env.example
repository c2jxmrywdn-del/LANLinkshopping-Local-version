# ============================================================
# 本地环境变量模板：复制为 .env 后填写（.env 已被 .gitignore 忽略，不要提交）
#   .env 供 docker-compose.local.yml 使用；
#   同名变量也用于启动后端（启动本地环境.bat / PowerShell 会读取）。
# ============================================================

# ---- 数据库（本机 MySQL 8，账号 root）----
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/lanlink_shopping?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=<你的 MySQL root 密码>

# ---- 客服学习沙盒（docker-compose.local.yml）----
# 必须至少 40 字符，例如：powershell -c "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"
SUPPORT_SANDBOX_TOKEN=<40字符以上的随机令牌>
SUPPORT_SANDBOX_URL=http://127.0.0.1:18080
SUPPORT_SANDBOX_MODE=container

# ---- 本地邮件（Mailpit，一般无需修改）----
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=lanlink@local.dev
MAIL_PASSWORD=lanlink-local
MAIL_SMTP_SSL=false

# ---- 客服可信代理密钥（SupportRequestGuard 校验）----
# 必须提供，禁止使用固定默认值（仓库不携带任何密钥）。
# 生成示例：powershell -c "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"
# 前端 Vite 代理与后端 application-dev.yml 读取同名变量，两端必须一致。
SUPPORT_PROXY_SECRET=<40字符以上的随机密钥>
# 智能客服思考模式（网关内部推理，最终回答不显示思考过程/知识库来源；false 可关闭）
SUPPORT_AI_THINKING=true

# ---- Redis 缓存（docker-compose 的 redis 服务与后端共用此密码）----
# 必须提供，禁止使用固定默认值（仓库不携带任何密钥）。
# 生成示例：powershell -c "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"
# 容器内后端用 REDIS_HOST=redis 走服务网络；本机直连时改为 127.0.0.1。
REDIS_PASSWORD=<40字符以上的随机密码>
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================
# ---- AI 专用环境变量组（外部大模型 API Key，仅 AI 调用使用）----
# 说明：后端出站模型渠道（客服润色/意图理解/价格智能分析等）按渠道读取：
#   MIMO  渠道  → AI_MIMO_API_KEY / AI_MIMO_BASE_URL
#   QWEN  渠道  → AI_QWEN_API_KEY / AI_QWEN_BASE_URL（兼容 DASHSCOPE_API_KEY 旧名）
#   DEEPSEEK 渠道 → AI_DEEPSEEK_API_KEY / AI_DEEPSEEK_BASE_URL
# 留空 = 该渠道禁用（后端自动回退规则引擎）。Key 只走环境变量/管理后台配置，
# 不要写进代码或提交到仓库。
# ============================================================
AI_MIMO_API_KEY=
AI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
AI_QWEN_API_KEY=
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ---- 本地向量知识库（AI KB）：Ollama 嵌入 + qwen2.5 RAG 问答 ----
# Ollama 地址（后端容器内经 host.docker.internal 访问宿主机 11434）
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
# 嵌入模型：推荐 bge-m3（多语言，1024 维，中文语义区分度好；需先 `docker exec lanlink-ollama ollama pull bge-m3`）
# 轻量可回落 nomic-embed-text（768 维，英文强、中文弱，配合 hybrid 词面重排仍可用）
# 切换模型后需清空 Redis 向量库（aikb:*）并重启后端，让 bootstrap 用新维度重建索引。
AI_EMBED_MODEL=bge-m3
# bge-m3=1024；nomic-embed-text=768。部署切换模型时同步修改，避免降级哈希向量误建新索引。
AI_EMBED_DIM=1024
# 商品知识 outbox worker（发布/审核/编辑后可靠重建向量；关闭后仍保留事件与夜间快照）
AI_KB_OUTBOX_ENABLED=true
AI_KB_OUTBOX_POLL_MS=15000
AI_KB_OUTBOX_BATCH_SIZE=5
AI_KB_OUTBOX_LEASE_MINUTES=20
# AI 网关密钥：必须由你生成并轮换，禁止沿用仓库默认值。
AI_GATEWAY_API_KEY=replace-with-a-long-random-secret
# 设置后 /kb/reload 还需携带 X-Admin-Key；未设置时保持仅网关 API Key。
GATEWAY_ADMIN_KEY=
GATEWAY_RATE_LIMIT_PER_MIN=120
GATEWAY_RATE_LIMIT_BURST=30
# 仅压测/基准环境可设为 1，允许 X-Bypass-Rate-Limit 头豁免限流；生产必须为 0。
GATEWAY_ALLOW_BYPASS_HEADER=0
# 可选：/metrics 独立令牌；设置后 Prometheus 需携带 Authorization: Bearer 或 X-Metrics-Token。
# 占位说明：真实值只写根 .env（勿提交），并同步写入 monitoring/prometheus/metrics_token
# （已 gitignore；由根 docker-compose.yml 只读挂载为 Prometheus credentials_file）。
GATEWAY_METRICS_TOKEN=
# AI 工具内部服务密钥（后端与 ai-gateway 必须同值；多值用逗号分隔以支持轮换）
INTERNAL_GATEWAY_SECRET=replace-with-another-long-random-secret
# 出站大模型域名白名单；自定义服务商需显式追加主机名
AI_OUTBOUND_ALLOWED_HOSTS=api.deepseek.com,dashscope.aliyuncs.com,dashscope-intl.aliyuncs.com,api.xiaomimimo.com,open.bigmodel.cn,api.openai.com,api.moonshot.cn,api.siliconflow.cn,localhost,127.0.0.1,host.docker.internal,lanlink-ai-gateway,ai-gateway,ollama,llama-cpp
# 本地 RAG 生成模型（Ollama 兜底；llama.cpp router 未就绪时使用，如 qwen2.5:0.5b）
AI_LOCAL_CHAT_MODEL=qwen2.5:7b
# 长上下文/兜底文本模型（Ollama，默认轻量 0.5b；本地 7B 由 llama.cpp router 提供）
AI_TEXT_MODEL=qwen2.5:0.5b
# ---- 本地双模型（llama.cpp router 模式，Docker 托管，推荐）----
# 一台 8GB 显存只能同时装一个 7B：router 模式在 qwen2.5-7b(文本) / qwen2.5-vl(视觉) 间按需切换。
# 启动：docker compose -f docker-compose.yml up -d（含 llama-model-init + llama-cpp，模型首次自动导入卷）
# 宿主机源目录（首次导入 Docker 命名卷 llama-models）：按实际 GGUF 路径修改
LLAMA_MODELS_DIR=D:/Docker/toolbox/llama.cpp/models
# 后端外部渠道默认文本模型（客服/价格分析走 7B）；视觉显式走 VL
AI_GATEWAY_MODEL=qwen2.5-7b
AI_GATEWAY_VL_MODEL=qwen2.5-vl
AI_GATEWAY_TEXT_MODEL=qwen2.5-7b
# 容器内 DNS（llama.cpp 服务在根 compose 的 llama-cpp 服务）
AI_MODEL_ROUTER_URL=http://llama-cpp:8123/v1
# 后端访问 ai-gateway 的 OpenAI 兼容基址（容器内服务名 / 宿主机 host.docker.internal 二选一）
AI_GATEWAY_BASE_URL=http://lanlink-ai-gateway:8090/v1
# ---- 向量知识库 MCP 读取通道（契约见 ai-gateway/MCP_KB_SPEC.md）----
# /mcp 挂在网关根路径，不带 /v1，不能复用 AI_GATEWAY_BASE_URL。
# 智能客服接地优先走这里读 aikb-idx；关闭或网关不可达时自动回退 Java 直连检索。
AI_KB_MCP_ENABLED=true
AI_GATEWAY_MCP_URL=http://lanlink-ai-gateway:8090/mcp
# ---- 外部嵌入 / 聊天通道（暂停本地模型时改用；留空即沿用本地链路）----
# provider: ollama|openai（openai 需同时填 BASE_URL/API_KEY/MODEL，任一为空则不生效）
AI_EMBED_PROVIDER=ollama
AI_EMBED_BASE_URL=
AI_EMBED_API_KEY=
AI_CHAT_PROVIDER=local
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
# 切换嵌入模型（本地换维度或改外部 provider）后必须重灌向量库：
# POST /admin/kb/ingest?source=all，否则新旧向量同维度混存会污染检索。
# 文本模型 KV 上限（num_ctx，越大长文本能力越强、显存/内存占用越高）
AI_TEXT_NUM_CTX=12288
# 文本模型闲置驻留时长（Ollama 兜底模型到期自动卸载）
AI_TEXT_KEEP_ALIVE=5m
# 长上下文阈值（字符，仅保留配置兼容；auto 已默认文本模型）
AI_LONG_CONTEXT_CHARS=1200
# ---- 外部资讯自动抓取（RSS -> t_market_news -> Redis 向量库，每 2 小时）----
AI_EXTERNAL_ENABLED=true
AI_EXTERNAL_FEEDS=https://www.ithome.com/rss/,https://www.36kr.com/feed,https://rss.huxiu.com/,https://feeds.a.dj.com/rss/RSSMarketsMain.xml
AI_EXTERNAL_LIMIT=30
# 摘要缺失时用本地 7B 生成中文摘要（最多 2 条/轮，失败忽略）
AI_EXTERNAL_LLM_SUMMARY=true
# 业务相关性过滤：娱乐/消费电子/会员促销/生活方式类资讯不入库（B2B 每日资讯质量）
AI_EXTERNAL_RELEVANCE_FILTER=true
# ---- 意图理解增强（关键词规则 -> 向量 KNN -> 本地 7B 分类，逐级回退）----
AI_INTENT_LLM_ENABLED=true
AI_INTENT_VECTOR_MIN_SCORE=0.55
# ---- AI 商品标题润色配额（out/ai-polish-design.md §3.4，独立键 ai-polish，与价格分析 PRICE_AI_HOURLY_QUOTA 互不挤占）----
# 商户级 10 次/小时/商户（公平闸，防单商户耗尽全局额度）；全局 backstop 60 次/小时（防多商户合计打爆计费渠道）
# 两层均 <=0 时各自关闭
AI_POLISH_USER_HOURLY_QUOTA=10
AI_POLISH_HOURLY_QUOTA=60
# 出站模型配置加密密钥（管理后台 AI 与密钥配置的落库加密，必须提供）
AI_OUTBOUND_KEY_SECRET=<40字符以上的随机密钥>

# ============================================================
# ---- 共享环境变量组（高频复用，多处引用同一份值）----
# 前后端/多容器共用：改一处全端生效，避免散落同名变量不同值。
# ============================================================
# 应用对外域名/地址（前端跳转、回调、邮件链接等引用）
APP_PUBLIC_URL=http://localhost:5173
# 后端 API 基址（前端构建注入 VITE_API_BASE_URL，默认 /api 走同源代理）
VITE_API_BASE_URL=/api
# ---- 高德地图开放平台商业图源配置（可选；后端侧变量，仅后端持有，不进前端构建产物） ----
# 申请地址：https://console.amap.com/（创建 Web 端 JS API Key）
# docker-compose 注入 backend 容器；登录用户经 GET /api/logistics/map-config 拉取，留空时前端回退内置高精中国地理矢量底图
AMAP_KEY=your_amap_jsapi_key_here
AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here
# 限流与安全通用参数
AUTH_RATE_LIMIT_PER_MIN=20
# 演示数据开关（后端 DataInitializer）
LANLINK_DEMO_DATA_ENABLED=true
# 时区（调度任务/日期聚合统一时区，价格监控每日基准等依赖）
APP_TIMEZONE=Asia/Shanghai

# ============================================================
# ---- 对象存储与消息队列（out/storage-mq-plan.md A1/A2/B1/B4，docker-compose 的 minio/rabbitmq 服务）----
# 说明：库内一律存 object key（如 products/1001.webp），出站拼公开绝对 URL；
#       docker compose up 前必须填写 MINIO_*/RABBITMQ_*/LANLINK_S3_*（compose 用 :? 强制校验）。
#       LANLINK_S3_ACCESS_KEY/SECRET_KEY 是专用最小权限应用账号（固定名 lanlink-app，
#       minio-init 首次 up 时幂等创建、只授 products/* 的 Get/Put/Delete），必须与
#       MINIO_ROOT_* 不同值——root 凭据只留在 MINIO_ROOT_*，绝不注入后端
#       （LANLINK_S3_* 为空时后端启动即 fail-fast，无 minioadmin 兜底）。
# ============================================================
# MinIO root 凭据（仅 minio / minio-init 两个容器使用；建桶/策略/运维走 mc 时用）
# 生成示例：powershell -c "[guid]::NewGuid().ToString('N')"
MINIO_ROOT_USER=<本地 MinIO root 用户名>
MINIO_ROOT_PASSWORD=<本地 MinIO root 密码>
# 后端专用 S3 账号（账号名即访问键）：密码须 32+ 位随机串且与 MINIO_ROOT_PASSWORD 不同值
LANLINK_S3_ACCESS_KEY=lanlink-app
LANLINK_S3_SECRET_KEY=<32位以上随机串，与 MINIO_ROOT_PASSWORD 不同值>
# RabbitMQ 凭据（AMQP 127.0.0.1:5672 / 管理 UI 127.0.0.1:15672，均仅绑回环）
# 注意：节点挂持久化卷后 RABBITMQ_DEFAULT_USER/PASS 仅首启生效；改密码须先
# rabbitmqctl change_password 再同步改这里（流程见 docker-compose.yml rabbitmq 段注释）
RABBITMQ_USER=<本地 RabbitMQ 用户名>
RABBITMQ_PASSWORD=<本地 RabbitMQ 密码>
# 三节点共享 Erlang cookie：三节点必须同值，生产使用长随机串，不要提交明文
RABBITMQ_ERLANG_COOKIE=<长随机 cookie>
# 对象存储全链路开关：false = 上传回退本地盘、出站 URL 原样输出（一键回退现状）
LANLINK_STORAGE_ENABLED=true
# S3 端点（本机/裸跑后端用 localhost:9000；compose 内后端容器由 compose 固定注入 http://minio:9000）
LANLINK_S3_ENDPOINT=http://localhost:9000
LANLINK_S3_REGION=us-east-1
LANLINK_S3_BUCKET=products
# MinIO 必须 true（path-style）；切腾讯 COS/阿里 OSS 时改 false（仅改 env，代码零改动）
LANLINK_S3_PATH_STYLE=true
# 浏览器侧公开读地址（出站拼 URL 前缀；prod 换实际存储域名/CDN）
LANLINK_S3_PUBLIC_BASE_URL=/products
# 订单支付流消费通道开关：mq=走 RabbitMQ（默认），event=回退 Spring 事件通道（与 MQ 互斥防双计）
LANLINK_MQ_ORDER_FLOW=mq
# 系统通知消费通道开关：mq=RabbitMQ + Outbox 重投（默认），event=回退提交后直发监听器（与 MQ 互斥，防双发）
LANLINK_MQ_NOTIFY_FLOW=mq

# ============================================================
# ---- Stripe 跨境国际支付与多渠道收银配置 ----
# ============================================================
# 后端私钥：API 扣款与 PaymentIntent 创建密钥 (sk_test_... 或 sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# 后端 Webhook 验签密钥 (whsec_...)，从 Stripe 开发者仪表板 Webhook 端点获取
STRIPE_WEBHOOK_SECRET=
# 默认结算货币代码 (三位 ISO 小写代码，默认 cny，可选 usd, eur, hkd)
STRIPE_CURRENCY=cny
# 前端公钥：用于挂载 Stripe Elements 与 Apple Pay / Google Pay 快捷支付 (pk_test_... 或 pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ============================================================
# ---- 自建物流跟踪（out/logistics-tracking-plan.md P1，backend module/tracking）----
# 说明：真实渠道密钥仅由后端经环境变量持有，不入库不入仓（t_logistics_provider.api_key 不存真值）。
#       留空=对应通道 configured()=false，自动退化为定时补拉兜底路径，回调链路仍可验签演示。
# ============================================================
# 快递100 企业版授权（订阅推送需企业版；申请地址 https://api.kuaidi100.com，后端侧变量不进前端）
TRACKING_KUAIDI100_KEY=your_kuaidi100_key_here
TRACKING_KUAIDI100_CUSTOMER=your_kuaidi100_customer_here
# 推送方向验签盐：sign=MD5(param+salt) 32 位大写；泄露=任何人可伪造推送，务必长随机串
TRACKING_KUAIDI100_SALT=your_kuaidi100_salt_here
# 请求端签名算法 SHA256/MD5（推送回调方向固定 MD5，不可升级）
TRACKING_KUAIDI100_SIGN_TYPE=SHA256
# 回调 URL 路径段共享 token（Mock/17TRACK 共用；默认 dev-callback-token 仅本地演示，
# 生产必须换 32 位随机 hex，如 powershell -c "[guid]::NewGuid().ToString('N')+..." 拼接）
TRACKING_CALLBACK_URL_TOKEN=your_callback_url_token_here
# 跟踪链路总开关（false 时 ship 主流程零影响，仅 tracking 侧短路）
TRACKING_ENABLED=true
# 成功回调/成功补拉后顺延 next_poll_time 的间隔 ms（巡检 cron 默认每 10 分钟，见 application.yml）
TRACKING_POLL_INTERVAL_MS=600000
