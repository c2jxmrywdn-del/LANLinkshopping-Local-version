# Public browser analytics key (Vite exposes VITE_* values in the client bundle).
# Set the real value in your local .env file and in Vercel Project Settings.
VITE_AMPLITUDE_API_KEY=

# Vercel Workflow 服务基址（仓库内 workflow/ 子应用，本地默认 http://localhost:3000）
VITE_WORKFLOW_URL=http://localhost:3000

# 对象存储公开读取基址（storage-mq-plan 任务 A5 兼容层）：/products/... 相对路径渲染前拼接
# 该前缀；不设置时原样返回 = 回退 Vite public 目录（frontend/public/products/ 回退源保留）。
# 本地 dev 默认 MinIO 公开桶；生产构建经 Dockerfile ARG VITE_STORAGE_PUBLIC_BASE 注入实际存储域。
VITE_STORAGE_PUBLIC_BASE=http://localhost:9000/products
