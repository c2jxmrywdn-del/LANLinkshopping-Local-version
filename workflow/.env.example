# Spring Boot 后端 API 基址（容器内可用 http://backend:8080/api）
BACKEND_API_BASE=http://localhost:8080/api

# 用于批量导入的服务账号（需具备商户身份且已过审，拥有 product:publish 权限）
WORKFLOW_BACKEND_PHONE=
WORKFLOW_BACKEND_PASSWORD=

# 允许跨域调用本服务的前端来源：可为 "*"，或逗号分隔的来源白名单（命中则回显该来源）。
# 开发环境同时覆盖 Docker 前端(:5173) 与本地 Vite 开发服务器(:5174)；生产收紧为具体域名。
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
