<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="LanlinkShopping-dev" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <module name="lanlink-shopping" />
    <option name="SPRING_BOOT_MAIN_CLASS" value="com.lanlink.shopping.LanlinkShoppingApplication" />
    <option name="ACTIVE_PROFILES" value="dev" />
    <option name="VM_PARAMETERS" value="-Dfile.encoding=UTF-8 -Duser.timezone=GMT+8 -Xms256m -Xmx512m" />
    <option name="PROGRAM_PARAMETERS" value="--server.port=8080 --lanlink.crypto.secret=替换为你的强随机密钥并长期保持不变" />
    <option name="WORKING_DIRECTORY" value="file://$ProjectFileDir$/backend" />
    <envs>
      <!-- 邮箱验证码 SMTP：留空则自动回退演示模式(直接回 devCode)。QQ 邮箱用「授权码」而非登录密码。 -->
      <env name="MAIL_HOST" value="smtp.qq.com" />
      <env name="MAIL_PORT" value="465" />
      <env name="MAIL_USERNAME" value="你的邮箱@qq.com" />
      <env name="MAIL_PASSWORD" value="你的SMTP授权码" />
    </envs>
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
