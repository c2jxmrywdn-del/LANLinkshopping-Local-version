{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::products/*", "arn:aws:s3:::support-media/support/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::products/attachments/*",
        "arn:aws:s3:::support-media/support/*"
      ]
    }
  ]
}
